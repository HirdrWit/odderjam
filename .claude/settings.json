{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(python3 -m unittest *)",
      "Bash(ruff *)",
      "Bash(.venv/bin/ruff *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json"
}
