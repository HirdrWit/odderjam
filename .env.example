# The Odds API key (https://the-odds-api.com). Leave empty to use mock data.
ODDS_API_KEY=
# Sports to fetch (each costs ~2 credits per fetch: us+eu regions)
ODDS_SPORTS=NFL,NBA
# Minutes before live odds are re-fetched; UI polling is served from cache
ODDS_CACHE_MINUTES=120
# Sharp books (and weights) whose devigged prices are averaged into the fair price.
# Events missing a book are priced from the others. The UI can override per session.
SHARP_WEIGHTS=Pinnacle:1,Circa Sports:0.5,Novig:0.5,BetOnline.ag:0.25
# Sharp books holding more than this percent are left out (wide market = unreliable fair price)
MAX_SHARP_HOLD=6
